# ---- Runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---- Infrastruttura ----
# Usati dalle app in locale (pnpm dev:*). In Docker Compose vengono sovrascritti con gli host dei servizi.
DATABASE_URL=postgres://ernie:ernie@localhost:5432/ernie
REDIS_URL=redis://localhost:6379

# Credenziali del container Postgres (docker-compose.yml)
POSTGRES_USER=ernie
POSTGRES_PASSWORD=ernie
POSTGRES_DB=ernie

# ---- Provider LLM (necessari dalla M2; mai committare valori reali) ----
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Ricerca web (Firecrawl, dalla M5) ----
FIRECRAWL_API_KEY=

# ---- LiteLLM (profilo opzionale `litellm` di docker compose) ----
# LITELLM_MASTER_KEY=sk-change-me
