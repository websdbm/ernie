# ---- Runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---- Infrastruttura ----
# Usati dalle app in locale (pnpm dev:*). In Docker Compose vengono sovrascritti con gli host dei servizi.
# Le app si connettono con il ruolo applicativo (RLS attiva); le migrazioni con il proprietario.
# Le password qui sotto sono SOLO per lo sviluppo locale in Docker: in produzione vanno cambiate.
DATABASE_URL=postgres://ernie_app:ernie_app@localhost:5433/ernie
MIGRATIONS_DATABASE_URL=postgres://ernie:ernie@localhost:5433/ernie
APP_DB_PASSWORD=ernie_app
REDIS_URL=redis://localhost:6380

# Credenziali del container Postgres (docker-compose.yml)
POSTGRES_USER=ernie
POSTGRES_PASSWORD=ernie
POSTGRES_DB=ernie

# ---- Agente ----
# Origin ammessi sull'upgrade WebSocket (CSV); i client nativi non inviano Origin.
WS_ALLOWED_ORIGINS=
# Tetto di spesa LLM giornaliero per utente (USD), salvo users.settings.dailyBudgetUsd
LLM_DAILY_BUDGET_USD=2
# Modelli per classe (ID OpenRouter verificati l'11 ott 2026)
MODEL_LIGHT=anthropic/claude-haiku-5.5
MODEL_STANDARD=anthropic/claude-sonnet-5.5
MODEL_HEAVY=anthropic/claude-opus-5.5

# ---- Provider LLM (necessari dalla M2; mai committare valori reali) ----
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Ricerca web (Firecrawl, dalla M5) ----
FIRECRAWL_API_KEY=

# ---- Email (Brevo: promemoria via email e inoltro al second brain) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Ernie
# Inoltro email al second brain (B3): dominio di ricezione con MX verso Brevo e chiave del webhook (min 16 caratteri)
BRAIN_INBOUND_SECRET=
BRAIN_INBOUND_DOMAIN=

# ---- LiteLLM (profilo opzionale `litellm` di docker compose) ----
# LITELLM_MASTER_KEY=sk-change-me

# Second Brain: sincronizzazione Git ogni 5 min; consolidamento massimo una volta ogni 24 ore.
# 0 disabilita il consolidamento automatico (non la sincronizzazione Git).
BRAIN_REVIEW_INTERVAL_S=86400

# Voce online (17 ott 2026): Drama 3 via OPENROUTER_API_KEY. Ripiego iOS nell'app.
TTS_ENABLED=true
# Facoltativo: ID voce Fish Audio; se assente usa la voce predefinita del provider.
# TTS_VOICE_ID=
TTS_TIMEOUT_MS=20000
# Stima prudente per budget: listino pieno, non promozione. USD/milione di byte UTF-8.
TTS_USD_PER_M_BYTES=10

# SSH: encryption key (32 random bytes, base64). Back up outside the database; never rotate blindly.
# SSH_MASTER_KEY_B64=
